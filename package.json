{
  "name": "junguang-jia",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "photos:catalog": "node scripts/generate-photo-catalog.mjs",
    "predev": "npm run photos:catalog",
    "dev": "vite --host 0.0.0.0 --port 47331 --strictPort",
    "prebuild": "npm run photos:catalog",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0 --port 47331 --strictPort",
    "cf:preview": "npm run build && wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/eb-garamond": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.145.0"
  }
}
